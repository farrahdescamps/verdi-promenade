# ==============================================
# CONFIGURATION DE L'HÔTEL - OBLIGATOIRE
# ==============================================

# ID unique de votre hôtel (fourni par l'API)
# Exemple: "care-hotel-paris" ou un ID numérique
VITE_HOTEL_ID=

# Nom de votre hôtel (affiché dans l'interface)
# Exemple: "Care" ou "Hotel Luxe Paris"
VITE_HOTEL_NAME=Care


# ==============================================
# CONFIGURATION DES API - OBLIGATOIRE
# ==============================================

# URL de l'API principale
# En développement: utilisez le proxy local "/api"
# En production: URL complète de votre API
VITE_API_URL=/api

# URL de l'API Concierge
# En développement: utilisez le proxy local "/concierge-api"
# En production: URL complète de votre API Concierge
VITE_CONCIERGE_API_URL=/concierge-api


# ==============================================
# AUTHENTIFICATION API - OPTIONNEL
# ==============================================

# Clé API pour l'authentification (si utilisée)
# Laissez vide si vous n'utilisez pas d'API key
VITE_API_KEY=

# Token Bearer pour l'authentification (si utilisé)
# Laissez vide si vous n'utilisez pas de Bearer token
VITE_AUTH_BEARER=


# ==============================================
# NOTES IMPORTANTES
# ==============================================
# 
# 1. Copiez ce fichier en .env pour votre environnement local :
#    cp .env.example .env
#
# 2. Les variables VITE_ sont accessibles côté client
#    Ne mettez JAMAIS de secrets sensibles ici
#
# 3. Après modification du .env, redémarrez le serveur de développement :
#    npm run dev
#
# 4. En production (Vercel), configurez ces variables dans :
#    Project Settings > Environment Variables
#
